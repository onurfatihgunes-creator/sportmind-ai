EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — defaults to http://127.0.0.1:8000 (a local OnurAI/Vera dev
# server). See services/onuraiClient.ts.
EXPO_PUBLIC_ONURAI_API_URL=

# Optional — RevenueCat's Android-specific public API key. Unset until a
# real SportMind Pro product exists in Google Play Console/RevenueCat; see
# services/revenueCat.ts. Never a secret to hide (RevenueCat's app-specific
# keys are client-safe by design), just not invented ahead of a real product.
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
