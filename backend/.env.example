FOOTBALL_DATA_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional — basketball sync is skipped (not a failure) if this is left blank.
BALLDONTLIE_API_KEY=
# Optional — Süper Lig sync is skipped (not a failure) if this is left blank.
RAPIDAPI_FOOTBALL_KEY=
# Optional — BSD enrichment (lineups/stats/injuries/player-stats) is skipped if this is left blank.
BSD_API_TOKEN=
# Required to run `npm run serve` (backend/src/service/server.ts) — the
# service-boundary HTTP endpoint external callers (e.g. Vera) use for match
# analysis. Not read by the ingestion pipeline (`npm run run`).
SPORTMIND_SERVICE_TOKEN=
PORT=8787
